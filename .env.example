# Would You Fund It? settings. All optional; on GitHub set them as repository *variables* (none is a secret).
PJ_BASE_URL=          # canonical origin + path; default https://theguysaccount.github.io/pitch-judge-investor-game
PJ_CUSTOM_DOMAIN=     # e.g. wouldyoufundit.com; writes dist/CNAME (set PJ_BASE_URL to https://<domain> too)
PJ_GOATCOUNTER=       # https://<code>.goatcounter.com/count  cookieless counts (game_complete is the activation event)
PJ_SPONSOR_URL=       # the money slot: a "Support the game" link (e.g. GitHub Sponsors) in the footer
PJ_REPO=              # owner/name for correction links
PJ_OUT=               # build output directory; default dist/
CHROME=               # Chrome/Chromium binary for share images
